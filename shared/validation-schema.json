{
  "$comment": "工作紀錄欄位驗證規則，前後端共用的唯一事實來源。前端 src/validation/work-item.ts 直接 import；apps-script/Code.gs 的 VALIDATION_RULES 目前手動同步（npm run build:gs 自動轉檔尚未實作），改這裡要一起改 Code.gs。狀態的可選值是 src/types/work-item.ts 的 STATUS_OPTIONS（TypeScript 需要 as const 字面值型別，所以放在那邊），Code.gs 的 STATUS_OPTIONS 也要同步。日期的年份範圍用 minYear/maxYear 表示，不寫完整日期，前端（YYYY-MM-DD）與 API（YYYY/MM/DD）格式不同也能共用。",
  "fields": {
    "工作日期": {
      "label": "工作日期",
      "kind": "date",
      "required": true,
      "minYear": 2020,
      "maxYear": 2099
    },
    "交辦單位": { "label": "交辦單位", "kind": "select", "required": true, "maxLength": 50 },
    "交辦人員": { "label": "交辦人員", "kind": "select", "required": true, "maxLength": 50 },
    "專案名稱": { "label": "專案名稱", "kind": "select", "required": true, "maxLength": 50 },
    "專案Repo": {
      "label": "專案 Repo",
      "kind": "tags",
      "required": false,
      "maxLength": 50,
      "maxItems": 10,
      "forbiddenChars": ","
    },
    "工作目標": { "label": "工作目標", "kind": "text", "required": true, "maxLength": 500 },
    "處理內容": { "label": "處理內容", "kind": "text", "required": false, "maxLength": 2000 },
    "今日工時": {
      "label": "今日工時",
      "kind": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 24,
      "step": 0.25
    },
    "完成度": {
      "label": "完成度",
      "kind": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1
    },
    "預計期限": {
      "label": "預計期限",
      "kind": "date",
      "required": false,
      "minYear": 2020,
      "maxYear": 2099
    },
    "狀態": { "label": "狀態", "kind": "status", "required": true, "default": "待辦" }
  }
}
