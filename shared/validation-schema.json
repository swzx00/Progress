{
  "$comment": "工作紀錄欄位驗證規則，前後端共用的唯一事實來源。前端 src/validation/work-item.ts 直接 import；apps-script/Code.gs 的 VALIDATION_RULES 目前手動同步（npm run build:gs 自動轉檔尚未實作），改這裡要一起改 Code.gs。狀態的可選值是 src/types/work-item.ts 的 STATUS_OPTIONS（TypeScript 需要 as const 字面值型別，所以放在那邊），Code.gs 的 STATUS_OPTIONS 也要同步。日期的年份範圍用 minYear/maxYear 表示，不寫完整日期，前端（YYYY-MM-DD）與 API（YYYY/MM/DD）格式不同也能共用。",
  "fields": {
    "工作日期": {
      "label": "工作日期",
      "kind": "date",
      "required": true,
      "minYear": 2020,
      "maxYear": 2099
    },
    "交辦單位": { "label": "交辦單位", "kind": "select", "required": true, "maxLength": 50 },
    "交辦人員": { "label": "交辦人員", "kind": "select", "required": true, "maxLength": 50 },
    "專案名稱": { "label": "專案名稱", "kind": "select", "required": true, "maxLength": 50 },
    "專案Repo": {
      "label": "專案 Repo",
      "kind": "tags",
      "required": false,
      "maxLength": 50,
      "maxItems": 10,
      "forbiddenChars": ","
    },
    "工作目標": { "label": "工作目標", "kind": "text", "required": true, "maxLength": 500 },
    "處理內容": { "label": "處理內容", "kind": "text", "required": false, "maxLength": 2000 },
    "今日工時": {
      "label": "今日工時",
      "kind": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 24,
      "step": 0.25
    },
    "完成度": {
      "label": "完成度",
      "kind": "number",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 0.25
    },
    "預計期限": {
      "label": "預計期限",
      "kind": "date",
      "required": false,
      "minYear": 2020,
      "maxYear": 2099
    },
    "狀態": { "label": "狀態", "kind": "status", "required": true, "default": "待辦" }
  },
  "dailyHours": {
    "$comment": "同一工作日期所有未刪除紀錄（工作＋請假）的今日工時合計。warn：合計超過就把 DateNav 的「今日工時合計」換成紅字；max：合計超過就不能存（前端表單跟後端 Code.gs 都擋，Code.gs 的 DAILY_HOURS_MAX 手動同步）。",
    "warn": 8,
    "max": 24
  },
  "leave": {
    "$comment": "請假紀錄跟工作紀錄寫在同一個月份分頁、計入每日工時合計，用「狀態」等於 status 來區分。fixed 是請假列固定寫入的值（後端一律覆蓋，前端送什麼都不算數），這些值不會寫回「選項清單」，也不會出現在一般工作紀錄的下拉選單。假別存在「工作目標」、備註存在「處理內容」、請假時數存在「今日工時」。apps-script/Code.gs 的 LEAVE_RULES 手動同步。",
    "status": "休假",
    "fixed": {
      "交辦單位": "人事室",
      "交辦人員": "--",
      "專案名稱": "休假",
      "專案Repo": [],
      "預計期限": "",
      "完成度": 100
    },
    "types": ["特休", "事假", "病假", "其他"],
    "fields": {
      "工作日期": {
        "label": "請假日期",
        "kind": "date",
        "required": true,
        "minYear": 2020,
        "maxYear": 2099
      },
      "工作目標": { "label": "假別", "kind": "leaveType", "required": true },
      "處理內容": { "label": "備註", "kind": "text", "required": false, "maxLength": 2000 },
      "今日工時": {
        "label": "請假時數",
        "kind": "number",
        "required": true,
        "default": 8,
        "min": 0.25,
        "max": 8,
        "step": 0.25
      }
    }
  }
}
